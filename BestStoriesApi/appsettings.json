{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "MaxStories": 500,
    "MaxConcurrentRequests": 16,
    "MinimumCandidateCount": 100,
    "CandidateMultiplier": 3,
    "BestStoryIdsCacheSeconds": 60,
    "StoryCacheMinutes": 10
  }
}